{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "predev": "node -e \"require('fs').rmSync('public/hot',{force:true})\"",
        "dev": "concurrently -k -n VITE,PHP -c cyan,magenta \"vite\" \"php artisan serve --port=8000\"",
        "prebuild": "node -e \"require('fs').rmSync('public/hot',{force:true})\"",
        "build": "vite build",
        "watch": "vite build --watch",
        "serve": "php artisan serve --port=8000",
        "vite": "vite"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.3.3",
        "axios": "^1.11.0",
        "concurrently": "^9.0.1",
        "laravel-vite-plugin": "^2.0.0",
        "tailwindcss": "^4.3.3",
        "vite": "^7.0.7"
    }
}
