APP_NAME="ISP Billing"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Default: MariaDB, sama seperti database aplikasi. Aplikasi ini menjalankan
# web worker, queue worker ('automation'), dan scheduler ('schedule:run')
# sekaligus, sehingga database berbasis file (SQLite) tidak memadai.
#
#   1. Buat database & user:
#        sudo mariadb -e "CREATE DATABASE isp_billing CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;"
#        sudo mariadb -e "CREATE USER 'isp_billing'@'localhost' IDENTIFIED BY 'ganti-password';"
#        sudo mariadb -e "GRANT ALL PRIVILEGES ON isp_billing.* TO 'isp_billing'@'localhost'; FLUSH PRIVILEGES;"
#   2. Siapkan aplikasi:
#        git clone <repo> && cd isp-billing-app
#        cp .env.example .env          # Windows: copy .env.example .env
#        php artisan key:generate      # WAJIB - tanpa ini semua halaman balas 500
#        php artisan migrate --seed
#
# APP_KEY sengaja dibiarkan kosong di file ini dan tidak boleh diisi dengan
# nilai tetap yang di-commit, karena tiap instalasi harus punya kunci sendiri.
#
# Test memakai database TERPISAH (lihat phpunit.xml) supaya data pengembangan
# tidak terhapus saat menjalankan `php artisan test`.

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=isp_billing
DB_USERNAME=isp_billing
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Integrasi & Automasi (Backend 2)
# ---------------------------------------------------------------------------
# Nilai di bawah hanya default global. Per tenant bisa ditimpa lewat tabel
# settings, kecuali token API yang sengaja hanya ada di sini supaya tidak
# tersimpan sebagai JSON plaintext di database.

# RouterOS / Mikrotik (diakses lewat WireGuard, bukan port API publik)
MIKROTIK_DEFAULT_PORT=8728
MIKROTIK_DEFAULT_SUSPEND_METHOD=ppp_secret
MIKROTIK_DEFAULT_ADDRESS_LIST=satak-blocklist
MIKROTIK_CONNECT_TIMEOUT=5
MIKROTIK_READ_TIMEOUT=10
MIKROTIK_ATTEMPTS=2
MIKROTIK_RETRY_DELAY=1
# Beberapa RouterOS versi lama butuh login dua-tahap (write + {"name":"login"})
MIKROTIK_LEGACY_LOGIN=false
# Router yang tidak terjangkau selama N hari otomatis dinonaktifkan. 0 = jangan pernah.
MIKROTIK_OFFLINE_AFTER_DAYS=7

# WhatsApp — isi setelah token dari kantor tersedia.
# Nilai yang valid: disabled, fonnte, wablas
WHATSAPP_DEFAULT_PROVIDER=disabled
WHATSAPP_TIMEOUT=20
WHATSAPP_MAX_ATTEMPTS=3
WHATSAPP_BACKOFF_SECONDS=120

# Fonnte — POST {FONNTE_BASE_URL}/send, header "Authorization: {token}"
FONNTE_BASE_URL=https://api.fonnte.com
FONNTE_TOKEN=
# "0" mematikan penggantian awalan 0 menjadi kode negara, karena nomor tujuan
# sudah dinormalisasi ke format 62xxx oleh sistem.
FONNTE_COUNTRY_CODE=0
# Minta Fonnte hanya memverifikasi koneksi tanpa benar-benar mengirim pesan.
FONNTE_CONNECT_ONLY=false

# Wablas — POST {WABLAS_BASE_URL}/send-message, header "Authorization: {token}.{secret}"
WABLAS_BASE_URL=https://console.wablas.com/api
WABLAS_TOKEN=
WABLAS_SECRET_KEY=
WABLAS_SEND_REF_ID=true
