APP_NAME="ISP Billing"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Default: SQLite, supaya tidak perlu install apa pun.
#
#   git clone <repo> && cd isp-billing-app
#   cp .env.example .env          # Windows: copy .env.example .env
#   php artisan key:generate      # WAJIB - tanpa ini semua halaman balas 500
#   php artisan migrate --seed    # selesai, tidak perlu bikin file DB manual
#
# APP_KEY sengaja dibiarkan kosong di file ini dan tidak boleh diisi dengan
# nilai tetap yang di-commit, karena tiap instalasi harus punya kunci sendiri.
# Kalau lupa menjalankan key:generate, errornya "No application encryption key
# has been specified" dan setiap halaman langsung 500.
#
# File database/database.sqlite dibuat otomatis oleh Laravel, jadi tidak perlu
# `touch` dulu. File itu juga sudah masuk .gitignore dan tidak pernah ikut
# ter-commit.
#
# Ini sengaja sama dengan phpunit.xml (SQLite in-memory), sehingga hasil test
# mencerminkan kondisi pengembangan - tidak ada test yang hijau di sini tapi
# merah di sana.
#
# Untuk PRODUKSI, ganti ke MySQL. SQLite hanya bisa ditulis satu proses dalam
# satu waktu, sedangkan di server aplikasi berjalan web worker, queue worker
# ('automation'), dan scheduler ('schedule:run') sekaligus. Untuk aplikasi yang
# menagih uang pelanggan, risikonya tidak sepadan dengan hemat reinstall.
#
# PENTING: seluruh migration selama ini hanya pernah diverifikasi di SQLite.
# Sebelum production, jalankan `php artisan migrate:fresh` sekali di DB MySQL
# percobaan, karena ada sintaks yang hanya berlaku di MySQL (mis. ->after()).

DB_CONNECTION=sqlite
# --- opsi MySQL untuk produksi ---
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=isp_billing
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Integrasi & Automasi (Backend 2)
# ---------------------------------------------------------------------------
# Nilai di bawah hanya default global. Per tenant bisa ditimpa lewat tabel
# settings, kecuali token API yang sengaja hanya ada di sini supaya tidak
# tersimpan sebagai JSON plaintext di database.

# RouterOS / Mikrotik (diakses lewat WireGuard, bukan port API publik)
MIKROTIK_DEFAULT_PORT=8728
MIKROTIK_DEFAULT_SUSPEND_METHOD=ppp_secret
MIKROTIK_DEFAULT_ADDRESS_LIST=satak-blocklist
MIKROTIK_CONNECT_TIMEOUT=5
MIKROTIK_READ_TIMEOUT=10
MIKROTIK_ATTEMPTS=2
MIKROTIK_RETRY_DELAY=1
# Beberapa RouterOS versi lama butuh login dua-tahap (write + {"name":"login"})
MIKROTIK_LEGACY_LOGIN=false
# Router yang tidak terjangkau selama N hari otomatis dinonaktifkan. 0 = jangan pernah.
MIKROTIK_OFFLINE_AFTER_DAYS=7

# WhatsApp — isi setelah token dari kantor tersedia.
# Nilai yang valid: disabled, fonnte, wablas
WHATSAPP_DEFAULT_PROVIDER=disabled
WHATSAPP_TIMEOUT=20
WHATSAPP_MAX_ATTEMPTS=3
WHATSAPP_BACKOFF_SECONDS=120

# Fonnte — POST {FONNTE_BASE_URL}/send, header "Authorization: {token}"
FONNTE_BASE_URL=https://api.fonnte.com
FONNTE_TOKEN=
# "0" mematikan penggantian awalan 0 menjadi kode negara, karena nomor tujuan
# sudah dinormalisasi ke format 62xxx oleh sistem.
FONNTE_COUNTRY_CODE=0
# Minta Fonnte hanya memverifikasi koneksi tanpa benar-benar mengirim pesan.
FONNTE_CONNECT_ONLY=false

# Wablas — POST {WABLAS_BASE_URL}/send-message, header "Authorization: {token}.{secret}"
WABLAS_BASE_URL=https://console.wablas.com/api
WABLAS_TOKEN=
WABLAS_SECRET_KEY=
WABLAS_SEND_REF_ID=true
